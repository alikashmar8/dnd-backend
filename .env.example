# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dnd_db

# Database TLS (defaults: OFF in development, ON with cert verification in
# production). Managed providers with self-signed certs (RDS/Aurora) set:
#   DB_SSL=true
#   DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=true

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# NOTE: auth uses DeviceToken sessions, not JWT. These are read into config
# but not consumed by any service — kept for legacy compatibility only.
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# CORS Configuration
# Comma-separated allowlist of origins for credentialed requests, e.g.
#   CORS_ORIGIN=https://admin.dishanddash.com,https://www.dishanddash.com
# `*` (dev) reflects the request origin so credentialed requests keep working.
CORS_ORIGIN=*

# Storage Configuration (uses NODE_ENV to pick MinIO vs AWS S3)
# For local dev (NODE_ENV=development, MinIO at localhost:9000):
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY_ID=minioadmin
#   STORAGE_SECRET_ACCESS_KEY=minioadmin
#
# For production (NODE_ENV=production, AWS S3):
#   STORAGE_ACCESS_KEY_ID=your-aws-access-key
#   STORAGE_SECRET_ACCESS_KEY=your-aws-secret-key
#   No STORAGE_ENDPOINT needed (uses default S3 endpoint)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your-storage-access-key
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-key
STORAGE_BUCKET=dnd-uploads
STORAGE_SIGNED_URL_EXPIRY=900

# Redis Configuration (driver-location cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
# DeviceToken session lifetime in days. Legacy tokens created before expiry
# existed have null expiresAt and remain valid (no mass logout).
AUTH_TOKEN_EXPIRY_DAYS=30

# Public base URL for customer-facing assets (images). The API returns absolute
# image URLs by concatenating this base with the stored object key.
#   Development (MinIO): http://<host>:9000/<STORAGE_BUCKET> (must be publicly
#     readable — see scripts/setup-minio-public.sh). Use the machine's LAN IP
#     (not localhost) when testing on a physical device.
#   Production (AWS): https://dXXXXXXXXXXXX.cloudfront.net (CloudFront in front
#     of the private S3 bucket — see docs/image-serving-cdn.md).
# ASSET_BASE_URL=http://localhost:9000/dnd-uploads

# Firebase Cloud Messaging Configuration
#
# The backend uses `firebase-admin` to send FCM v1 push notifications. Exactly
# one credential source is required:
#   A) FIREBASE_SERVICE_ACCOUNT_PATH pointing at a downloaded service-account
#      JSON file (convenient in development), OR
#   B) the FCM_* vars below (preferred in production / CI; private key must use
#      literal \n escapes, which the backend converts to real newlines).
# If neither is set, the backend FAILS FAST at startup (it does not silently
# run with push notifications disabled).
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/dish-and-dash-firebase-adminsdk-XXXXX.json
FCM_PROJECT_ID=your-fcm-project-id
FCM_CLIENT_EMAIL=your-fcm-client-email
FCM_PRIVATE_KEY=your-fcm-private-key

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=30
# Base URL used in the emailed reset link (e.g. https://dishanddash.com).
# If empty, the email still delivers the 6-digit code but the link is broken.
PASSWORD_RESET_URL=

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dishanddash.com
SMTP_FROM_NAME=Dish & Dash

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=