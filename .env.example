# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dish_and_dash

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=*

# Storage Configuration (uses NODE_ENV to pick MinIO vs AWS S3)
# For local dev (NODE_ENV=development, MinIO at localhost:9000):
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY_ID=minioadmin
#   STORAGE_SECRET_ACCESS_KEY=minioadmin
#
# For production (NODE_ENV=production, AWS S3):
#   STORAGE_ACCESS_KEY_ID=your-aws-access-key
#   STORAGE_SECRET_ACCESS_KEY=your-aws-secret-key
#   No STORAGE_ENDPOINT needed (uses default S3 endpoint)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your-storage-access-key
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-key
STORAGE_BUCKET=dnd-uploads

# Firebase Cloud Messaging Configuration
FCM_PROJECT_ID=your-fcm-project-id
FCM_PRIVATE_KEY_ID=your-fcm-private-key-id
FCM_PRIVATE_KEY=your-fcm-private-key
FCM_CLIENT_EMAIL=your-fcm-client-email
FCM_CLIENT_ID=your-fcm-client-id
FCM_AUTH_URI=https://oauth2.googleapis.com/token
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FCM_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-fcm-client-email

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=30

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dishanddash.com
SMTP_FROM_NAME=Dish & Dash

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=